# Proveedor de datos:
#   mock → semillas en memoria (default, arranca sin backend y SIN login)
#   rest → API REST de /api (montada en /api/v1/...) + autenticación
#          (con "rest" la app pide sesión en /login contra POST /api/auth/login)
VITE_DATA_PROVIDER=rest

# URL base pública de la API (usada solo con VITE_DATA_PROVIDER=rest).
# En producción debe usar HTTPS. Nunca pongas credenciales ni secretos en VITE_*:
# Vite las incorpora al bundle descargado por todos los usuarios.
VITE_API_URL=http://localhost:3000/api
