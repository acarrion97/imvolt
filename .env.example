# Proveedor de datos:
#   mock → semillas en memoria (default, arranca sin backend y SIN login)
#   rest → API REST de /api (montada en /api/v1/...) + autenticación
#          (con "rest" la app pide sesión en /login contra POST /api/auth/login)
VITE_DATA_PROVIDER=rest

# URL base de la API (usada solo con VITE_DATA_PROVIDER=rest).
# Producción: SIEMPRE https:// (el build rechaza http://). En desarrollo se
# admite http:// únicamente hacia localhost.
VITE_API_URL=

# ID público de la app de Meta (no es un secreto). Facebook Login SDK lo requiere.
VITE_META_APP_ID=
# ID de la configuración de Facebook Login for Business creada en Meta.
VITE_META_LOGIN_CONFIG_ID=
# Debe coincidir con META_GRAPH_API_VERSION configurada en la API.
VITE_META_GRAPH_API_VERSION=v24.0

# SOLO DESARROLLO: token Bearer para golpear la API sin pasar por el login.
# Se ignora en builds de producción. NO guardes aquí secretos reales: toda
# variable VITE_* se incrusta en el JavaScript público. Los secretos
# (service-role de Supabase, claves de Higgsfield/Meta) viven únicamente en
# el backend (imvolt-api), nunca en este repositorio.
#
# No hace falta con el login: la sesión del usuario (localStorage) tiene
# prioridad sobre esta variable.
VITE_API_TOKEN=
