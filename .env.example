# Proveedor de datos:
#   mock → semillas en memoria (default, arranca sin backend)
#   rest → API REST de /api (montada en /api/v1/...)
VITE_DATA_PROVIDER=mock

# URL base de la API (usada solo con VITE_DATA_PROVIDER=rest)
VITE_API_URL=http://localhost:3000/api

# Token Bearer opcional para desarrollo directo contra la API
# (en producción la sesión llega desde el login de /api/auth)
VITE_API_TOKEN=
